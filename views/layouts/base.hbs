<!DOCTYPE html>
<!-- Generated by build/index.js from views/ and content/. Edit those files, not this one. -->
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{title}}</title>
<link rel="stylesheet" href="style.css" />
</head>
<body>
<div class="app">
{{> header}}
{{{content}}}
{{> footer}}
</div>
{{#each scripts}}
<script src="{{this}}"></script>
{{/each}}
{{#if module}}
<script type="module" src="{{module}}"></script>
{{/if}}
</body>
</html>
