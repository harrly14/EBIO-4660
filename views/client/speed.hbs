<div class="speed">
  <button class="primary" type="button" data-action="speed-start">Start 60-second round</button>
  <span class="timer" data-role="timer">1:00</span>
  <span class="subtle" data-role="score">Score: 0</span>
  <span class="subtle" data-role="high-score">High score: {{highScore}}</span>
</div>
<div data-role="speed-area"><p class="subtle">{{intro}}</p></div>
